EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# FR-S4-P3-01: URL publik backend pembayaran Midtrans (Vercel / lokal).
# Bukan rahasia; seluruh secret key Midtrans hanya disimpan di backend/.env.
EXPO_PUBLIC_PAYMENT_API_URL=https://your-payment-backend.vercel.app

# FR-P1-03: Google Maps API key (Maps SDK for Android). Opsional; tanpa key
# peta Android kosong tetapi fitur lain tetap berjalan.
GOOGLE_MAPS_API_KEY=

