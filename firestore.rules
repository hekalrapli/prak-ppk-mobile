rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() {
      return request.auth != null;
    }
    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }
    function role() {
      return userDoc(request.auth.uid).data.role;
    }
    function isAsisten() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && role() == 'asisten';
    }
    function isPraktikan() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && role() == 'praktikan';
    }
    function practicum(pid) {
      return get(/databases/$(database)/documents/practicums/$(pid));
    }
    function isPengampu(pid) {
      return isAsisten() && practicum(pid).data.assistantId == request.auth.uid;
    }
    function isPeserta(pid) {
      return isPraktikan() && request.auth.uid in practicum(pid).data.studentIds;
    }
    function session(pid, sid) {
      return get(/databases/$(database)/documents/practicums/$(pid)/sessions/$(sid));
    }
    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function str(v, min, max) {
      return v is string && v.size() >= min && v.size() <= max;
    }
    function isValidExpoPushToken(t) {
      return str(t, 20, 120) && t.matches('^ExponentPushToken\\[.+\\]$');
    }
    function isValidFcmTokens(tokens) {
      return tokens is list
        && tokens.size() <= 5
        && (tokens.size() < 1 || isValidExpoPushToken(tokens[0]))
        && (tokens.size() < 2 || isValidExpoPushToken(tokens[1]))
        && (tokens.size() < 3 || isValidExpoPushToken(tokens[2]))
        && (tokens.size() < 4 || isValidExpoPushToken(tokens[3]))
        && (tokens.size() < 5 || isValidExpoPushToken(tokens[4]));
    }

    // ---------- Config (tidak bisa dibaca klien; hanya dipakai get() oleh rules) ----------
    match /config/{doc} {
      allow read, write: if false;
    }

    // ---------- Users ----------
    match /users/{uid} {
      // Pemilik membaca profilnya sendiri; asisten boleh membaca profil (untuk mencari praktikan sebagai peserta).
      allow read: if signedIn() && (request.auth.uid == uid || isAsisten());

      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name','identifier','email','role','createdAt','inviteCode'])
        && str(request.resource.data.name, 1, 60)
        && str(request.resource.data.identifier, 8, 20)
        && str(request.resource.data.email, 5, 100)
        && request.resource.data.createdAt == request.time
        && (
          (request.resource.data.role == 'praktikan' && !('inviteCode' in request.resource.data))
          ||
          (request.resource.data.role == 'asisten'
            && request.resource.data.inviteCode ==
               get(/databases/$(database)/documents/config/registration).data.asistenCode)
        );

      // Hanya pemilik yang boleh mengubah nama atau fcm_tokens miliknya; peran & identitas terkunci.
      allow update: if signedIn() && request.auth.uid == uid
        && onlyChanges(['name', 'fcm_tokens'])
        && str(request.resource.data.name, 1, 60)
        && (!('fcm_tokens' in request.resource.data)
            || isValidFcmTokens(request.resource.data.fcm_tokens));

      allow delete: if false;
    }

    // ---------- Laboratorium & Geofence ----------
    match /laboratorium/{labId} {
      // Asisten dan praktikan yang terdaftar dapat membaca titik lokasi & radius lab.
      allow read: if isAsisten() || isPraktikan();

      // Hanya asisten yang dapat membuat, mengubah, atau menghapus lokasi lab.
      allow create, update: if isAsisten()
        && request.resource.data.keys().hasAll(['nama','gedung','latitude','longitude','radius_meter','updated_at'])
        && request.resource.data.keys().hasOnly(['nama','gedung','latitude','longitude','radius_meter','updated_at'])
        && str(request.resource.data.nama, 1, 100)
        && str(request.resource.data.gedung, 0, 100)
        && request.resource.data.latitude is number
        && request.resource.data.latitude >= -90
        && request.resource.data.latitude <= 90
        && request.resource.data.longitude is number
        && request.resource.data.longitude >= -180
        && request.resource.data.longitude <= 180
        && request.resource.data.radius_meter is number
        && request.resource.data.radius_meter > 0
        && request.resource.data.radius_meter <= 1000
        && request.resource.data.updated_at == request.time;

      allow delete: if isAsisten();
    }

    // ---------- Practicums ----------
    match /practicums/{pid} {
      // Hanya asisten pengampu dan praktikan peserta yang boleh membaca.
      // Asisten lain tidak dapat menemukan praktikum ini sama sekali.
      allow read: if (isAsisten() && resource.data.assistantId == request.auth.uid)
        || (isPraktikan() && request.auth.uid in resource.data.studentIds);

      allow create: if isAsisten()
        && request.resource.data.assistantId == request.auth.uid
        && str(request.resource.data.name, 1, 100)
        && str(request.resource.data.className, 1, 30)
        && request.resource.data.studentIds is list;

      allow update: if isAsisten() && resource.data.assistantId == request.auth.uid
        && request.resource.data.assistantId == resource.data.assistantId
        && str(request.resource.data.name, 1, 100)
        && str(request.resource.data.className, 1, 30)
        && request.resource.data.studentIds is list;

      allow delete: if isAsisten() && resource.data.assistantId == request.auth.uid;

      // ---------- Sessions ----------
      match /sessions/{sid} {
        allow read: if isPengampu(pid) || isPeserta(pid);

        allow create: if isPengampu(pid)
          && request.resource.data.status == 'upcoming'
          && str(request.resource.data.room, 1, 60)
          && str(request.resource.data.date, 8, 30)
          && str(request.resource.data.startTime, 4, 5)
          && str(request.resource.data.endTime, 4, 5)
          && request.resource.data.endTime > request.resource.data.startTime
          && (!('lab_id' in request.resource.data) || str(request.resource.data.lab_id, 1, 100));

        // Edit jadwal (status tidak berubah) ATAU transisi status upcoming->open / open->closed.
        allow update: if isPengampu(pid) && (
          (request.resource.data.status == resource.data.status
             && resource.data.status != 'closed'
             && str(request.resource.data.room, 1, 60)
             && request.resource.data.endTime > request.resource.data.startTime
             && (!('lab_id' in request.resource.data) || str(request.resource.data.lab_id, 1, 100)))
          ||
          (resource.data.status == 'upcoming' && request.resource.data.status == 'open'
             && onlyChanges(['status','openedAt']))
          ||
          (resource.data.status == 'open' && request.resource.data.status == 'closed'
             && onlyChanges(['status','closedAt']))
        );

        allow delete: if isPengampu(pid);

        // ---------- Attendance (ID dokumen = UID praktikan) ----------
        match /attendance/{uid} {
          allow read: if isPengampu(pid)
            || (isPraktikan() && request.auth.uid == uid);

          allow create: if isPeserta(pid)
            && request.auth.uid == uid
            && session(pid, sid).data.status == 'open'
            && request.resource.data.keys().hasOnly(['praktikanId','praktikanName','praktikanNim','status','recordedAt','distance_meter','device_lat','device_lng','is_location_verified'])
            && request.resource.data.praktikanId == uid
            && request.resource.data.status == 'present'
            && request.resource.data.recordedAt == request.time
            // FR-P1-02: jejak geofence opsional (presensi lama tetap sah),
            // tetapi bila dikirim harus bertipe benar dan tidak negatif.
            && (!('distance_meter' in request.resource.data)
              || (request.resource.data.distance_meter is number
                  && request.resource.data.distance_meter >= 0))
            && (!('device_lat' in request.resource.data)
              || (request.resource.data.device_lat is number
                  && request.resource.data.device_lat >= -90
                  && request.resource.data.device_lat <= 90))
            && (!('device_lng' in request.resource.data)
              || (request.resource.data.device_lng is number
                  && request.resource.data.device_lng >= -180
                  && request.resource.data.device_lng <= 180))
            && (!('is_location_verified' in request.resource.data)
              || request.resource.data.is_location_verified == true);

          allow update, delete: if false;
        }

        // ---------- Leave requests (ID dokumen = UID praktikan) ----------
        match /leaveRequests/{uid} {
          allow read: if isPengampu(pid)
            || (isPraktikan() && request.auth.uid == uid);

          allow create: if isPeserta(pid)
            && request.auth.uid == uid
            && session(pid, sid).data.status in ['upcoming', 'open']
            && request.resource.data.keys().hasOnly(['praktikanId','praktikanName','praktikanNim','reason','status','createdAt'])
            && request.resource.data.praktikanId == uid
            && request.resource.data.status == 'pending'
            && str(request.resource.data.reason, 10, 500)
            && request.resource.data.createdAt == request.time;

          // Praktikan: ubah alasan selama pending. Asisten pengampu: hanya keputusan.
          allow update: if
            (
              isPeserta(pid) && request.auth.uid == uid
              && resource.data.status == 'pending'
              && onlyChanges(['reason'])
              && str(request.resource.data.reason, 10, 500)
            )
            ||
            (
              isPengampu(pid)
              && resource.data.status == 'pending'
              && request.resource.data.status in ['approved', 'rejected']
              && onlyChanges(['status','decidedBy','decidedAt','reviewNote'])
              && request.resource.data.decidedBy == request.auth.uid
              && request.resource.data.decidedAt == request.time
              && (!('reviewNote' in request.resource.data) || str(request.resource.data.reviewNote, 0, 200))
              && (request.resource.data.status == 'approved' || str(request.resource.data.reviewNote, 1, 200))
            );

          // Praktikan boleh membatalkan selama pending.
          allow delete: if isPeserta(pid) && request.auth.uid == uid && resource.data.status == 'pending';
        }

        // ---------- Hasil klasifikasi AI (hanya asisten pengampu) ----------
        // Dokumen terpisah dari leaveRequests agar praktikan tidak dapat melihat
        // maupun memalsukan hasil klasifikasi. Sejak FR-18 direvisi, hanya
        // asisten pengampu yang boleh menulis dokumen ini.
        match /leaveClassifications/{uid} {
          allow read: if isPengampu(pid);

          allow create: if isPengampu(pid)
            && request.resource.data.keys().hasOnly(['ai','updatedAt'])
            && request.resource.data.ai is map
            && request.resource.data.updatedAt == request.time;

          allow update: if isPengampu(pid)
            && onlyChanges(['ai','updatedAt'])
            && request.resource.data.ai is map
            && request.resource.data.updatedAt == request.time;

          allow delete: if false;
        }
      }
    }

    // ---------- Collection group: riwayat & izin pribadi lintas sesi ----------
    // Collection-group query wajib dibatasi where('praktikanId','==',uid);
    // aturan memakai field tersebut agar query dapat dibuktikan aman.
    match /{path=**}/attendance/{uid} {
      allow read: if isPraktikan() && resource.data.praktikanId == request.auth.uid;
    }
    match /{path=**}/leaveRequests/{uid} {
      allow read: if isPraktikan() && resource.data.praktikanId == request.auth.uid;
    }
  }
}
