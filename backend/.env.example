# ==============================================================================
# PrakYuks Payment Backend (Midtrans Sandbox + Firebase Admin SDK)
# Salin file ini menjadi `backend/.env` untuk pengujian lokal, atau masukkan
# seluruh variabel ini ke Vercel Project Settings -> Environment Variables.
# JANGAN PERNAH commit file `.env` asli ke Git!
# ==============================================================================

# Server Key dari Midtrans Sandbox (Settings -> Access Keys -> General Credentials)
# Pastikan berawalan SB-Mid-server-... (Sandbox)
MIDTRANS_SERVER_KEY=SB-Mid-server-REPLACE_ME

# Signature Secret Key dari Midtrans Sandbox (bagian atas halaman Access Keys)
# Dipakai untuk memverifikasi signature_key SHA-512 pada HTTP webhook Midtrans.
MIDTRANS_SIGNATURE_SECRET_KEY=REPLACE_ME

# Wajib false untuk lingkungan Sandbox (tidak memakai uang asli)
MIDTRANS_IS_PRODUCTION=false

# Kredensial Firebase Admin SDK (pilih SALAH SATU cara):
# 1. Rekomendasi untuk Vercel: isi 1 baris JSON service account (atau versi base64-nya)
FIREBASE_SERVICE_ACCOUNT_JSON=

# 2. Alternatif khusus lokal: path relatif ke file service account JSON
# FIREBASE_SERVICE_ACCOUNT_PATH=../secrets/prak-ppk-7-d45fd-firebase-adminsdk.json

# Port lokal (diabaikan otomatis saat berjalan di Vercel Serverless)
PORT=4000
