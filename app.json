{
  "expo": {
    "name": "Prakitiw",
    "slug": "prak-ppk-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "prakppkmobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.revanssss.prakppkmobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF8F2",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 112,
          "dark": {
            "backgroundColor": "#141110",
            "image": "./assets/images/splash-icon.png"
          }
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Prakitiw menggunakan lokasi Anda hanya saat aplikasi terbuka untuk memverifikasi kehadiran di dalam radius laboratorium."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Prakitiw memerlukan akses kamera untuk memindai kode QR presensi praktikum.",
          "recordAudioAndroid": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "424ffacd-ce35-4722-be6e-a57a6ec91a5d"
      }
    },
    "owner": "revanssss"
  }
}
